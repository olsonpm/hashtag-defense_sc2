<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
  <!-- Loading screen Constants -->
  <!-- Note: &lt;n/&gt; causes a new line in text. -->
  <Constant name="HDLoadingScreen_MapName" val=" #Defense " />
  <Constant name="HDLoadingScreen_bg" val="hashtag-defense/Assets/Textures/loading-screen.jpg" />
  <Constant name="HDLoadingScreen_Tab1Name" val="Добро пожаловать"/>
  <Constant name="HDLoadingScreen_Tab1On" val="True"/>
  <Constant name="HDLoadingScreen_Tab1Txt" val="
    1. Выберите, где обороняться &lt;n/&gt;
    2. Постройте лабиринт, по которому должны пройти ваши враги &lt;n/&gt;
    3. Покупайте боевые единицы и улучшения, чтобы бить врагов &lt;n/&gt;
    &lt;n/&gt;
    Сможете ли вы преодолеть все 25 волн?
    "/>

  <Constant name="HDLoadingScreen_Tab2Name" val="Основная информация"/>
  <Constant name="HDLoadingScreen_Tab2On" val="True"/>
  <Constant name="HDLoadingScreen_Tab2Txt" val="
    – Доход зависит от командных убийств. &lt;n/&gt;
    – Враги и их полученные эффекты случайны. &lt;n/&gt;
    – У большинства врагов есть тип, например, лёгкий/  &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
      бронированный/органический и т.д. &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
      Покупайте единицы, которые противостоят различным типам &lt;n/&gt;
      врагов. &lt;n/&gt;
    – В начале игры у вас 25 жизней. Жизни теряются, когда враги &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
      достигают конца своего пути. Чем больше у вас игроков, тем больше &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
      врагов должны дойти до конца, чтобы потерять жизнь. &lt;n/&gt;
    – Обязательно улучшайте свои единицы в исследовательском &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
      центре. &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
      Броня противников увеличивается в последующих раундах, делая &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
      ваши атаки менее эффективными.
      &lt;n/&gt;
  "/>

  <Constant name="HDLoadingScreen_Tab3Name" val="Подробное"/>
  <Constant name="HDLoadingScreen_Tab3On" val="True"/>
  <Constant name="HDLoadingScreen_Tab3Txt" val="
    – Введите «-commands» для просмотра доступных команд. Напр., &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
      «-autoskip» автоматически нажимает пропуск в каждом раунде. &lt;n/&gt;
    – Выборщики могут автоматически идти к маякам, щёлкнув &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
      левой кнопкой по маяку и нажав кнопку «Сбор». &lt;n/&gt;
    – Вы также можете автоматически улучшать свои единицы по мере &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
      появления минералов, нажав правой кнопкой по улучшению. &lt;n/&gt;
  "/>

  <Constant name="HDLoadingScreen_Tab4Name" val="Описания обновлений"/>
  <Constant name="HDLoadingScreen_Tab4On" val="True"/>
  <Constant name="HDLoadingScreen_Tab4Txt" val="
    вер. 1.01 &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
    – исправлена ошибка, из-за которой загруженные бункеры &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
      выгружались при отключении или исключении игрока. &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
    &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
    вер. 1.02 &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
    – исправлена ошибка, из-за которой бункер возвращал 10 ед. &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
      вместо 1 ед. &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
    – исправлена ошибка, из-за которой игра не начиналась, если &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
      последний игрок, выбиравший позицию обороны, был отключён &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
      или исключён. &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
    – добавлены недостающие тексты кнопок. &lt;n/&gt;&lt;s/&gt;&lt;s/&gt;
  "/>
  <Constant name="HDLoadingScreen_AuthorNameBottom" val="Автор: Nesbano0s"/>
  <Constant name="HDLoadingScreen_RussianTranslationByBottom" val="Перевод на русский: Berry"/>
  <!-- General (used in many places) -->
  <Constant name="HDGeneral_CopyText" val="Копировать Discord-ссылку!"/>
  <Constant name="HDGeneral_URLGet" val="Ссылка скопирована в буфер обмена!"/>
  <Constant name="HDGeneral_CopyLink" val="https://discord.gg/6ZfDWNF3jU"/>
  <!-- Ending Screen -->
  <Constant name="HDRoundEnd_DialogTitle" val="Спасибо за игру"/>
  <Constant name="HDRoundEnd_DialogTxt" val="Надеюсь, вам понравилось.&lt;n/&gt;&lt;n/&gt;Не стесняйтесь оставлять отзывы на нашем&lt;n/&gt;Discord-сервере."/>
</Desc>
